{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hero-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": {
    // HERO's GraphQL endpoint.
    "HERO_URL": "https://login.hero-software.de/api/external/v9/graphql",
    // Where this Worker is reachable (workers.dev or your own domain), without /mcp.
    "PUBLIC_URL": "https://hero-mcp.CHANGE-ME.workers.dev"
  },
  // The HERO API key is a secret: npx wrangler secret put HERO_API_KEY
  // Create the namespace with: npx wrangler kv namespace create OAUTH_KV, then paste its id here.
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "00000000000000000000000000000000" }],
  // Rate-limit namespace ids are shared across the whole Cloudflare account; keep them unique.
  "ratelimits": [
    { "name": "LOGIN_LIMIT", "namespace_id": "2001", "simple": { "limit": 10, "period": 60 } },
    { "name": "REGISTER_LIMIT", "namespace_id": "2002", "simple": { "limit": 20, "period": 60 } }
  ]
}
